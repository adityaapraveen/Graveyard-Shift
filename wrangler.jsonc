{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graveyard-shift",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "GraveyardAgent", "class_name": "GraveyardAgent" },
      { "name": "ResourceBiography", "class_name": "ResourceBiography" },
      { "name": "MockZone", "class_name": "MockZone" },
      { "name": "RealZone", "class_name": "RealZone" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GraveyardAgent", "ResourceBiography"] },
    { "tag": "v2", "new_sqlite_classes": ["MockZone"] },
    { "tag": "v3", "new_sqlite_classes": ["RealZone"] }
  ],
  "assets": { "directory": "./public/", "binding": "ASSETS", "run_worker_first": true },
  "workflows": [
    { "name": "graveyard-quarantine", "binding": "QUARANTINE_WORKFLOW", "class_name": "QuarantineWorkflow" }
  ],
  "vars": {
    "CF_MODE": "mock",
    "DRY_RUN": "true",
    "PROTECTED_NAMES": "www,mail,api",
    "OPENROUTER_MODEL": "openrouter/free"
  }
}
